# Frontend Environment Variables
# Copy this file to .env in the frontend/ folder and add your API keys:

# 1. FastAPI Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# 2. Google OAuth 2.0 Web Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 3. AI Provider API Keys (NVIDIA NIM / Llama 3 / Mistral / Gemini)
# Get free NVIDIA key at: https://build.nvidia.com
VITE_NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_OPENAI_API_KEY=your-openai-api-key-here
