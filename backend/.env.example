# =============================================================================
# FinShield Backend Environment Variables (.env)
# Copy this file to backend/.env and fill in your real API keys:
# =============================================================================

PROJECT_NAME="FinShield API"
ENVIRONMENT="development"
DEBUG=True

# 1. Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 2. Database Connection (PostgreSQL or local SQLite)
DATABASE_URL="sqlite:///./fintech_database.db"
# Or PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/finshield"

# 3. Google OAuth 2.0 Credentials (From Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. AI Security & Advisor API Keys (Optional)
GEMINI_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# 5. JWT Secret Key (Generate random 32+ character string)
SECRET_KEY="finshield-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
