# FinGuard Backend Environment Variables (Example)
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to GitHub

PROJECT_NAME="FinGuard API"
ENVIRONMENT="development"
DEBUG=True

# Server settings
HOST=127.0.0.1
PORT=8000

# CORS settings (allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Supabase database configuration placeholder
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key-here"

# JWT Secret Placeholder (for future authentication)
SECRET_KEY="super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
